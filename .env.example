# Copy to .env.local and fill in.
# Login for the single WorkHub account.
# If the password contains "$", write it as "\$" (Next.js treats $NAME as a variable).
WORKHUB_USER=admin
WORKHUB_PASSWORD=change-me
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`).
SESSION_SECRET=
# Optional: where the SQLite file lives (default: ./data/workhub.db).
# DATABASE_PATH=/absolute/path/workhub.db

# ---- Email (payment reminders, sent from the admin page) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your@gmail.com,
# SMTP_PASS=a 16-character App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender shown to recipients, e.g. "WorkHub <your@gmail.com>"
MAIL_FROM=
# Public address of the app, used for the link inside emails (e.g. https://workhub.example.com).
# Without it, links point at localhost and recipients cannot open them.
APP_URL=

# ---- Database: Firebase Firestore (optional) ----
# Without these the app uses the local SQLite file (data/workhub.db).
# Firebase console → Project settings → Service accounts → Generate new private key,
# save the JSON as secrets/firebase-key.json (the secrets/ folder is git-ignored):
# FIREBASE_SERVICE_ACCOUNT=secrets/firebase-key.json
# Force a driver if needed: DB_DRIVER=firestore | sqlite
